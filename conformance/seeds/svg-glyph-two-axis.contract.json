{
  "$schema": "./contract.schema.json",
  "id": "conformance.svg-glyph-two-axis",
  "name": "CaseSvgGlyphTwoAxis",
  "version": "0.1.0",
  "status": "draft",
  "description": "SEED contract for the CSS/DOM conformance fixture case \"svg-glyph-two-axis\" (svg). The fixture varies CSS CONSTRUCTS, not prop spaces, so the prop space is deliberately EMPTY: every axis the capture would enumerate is held at nothing, and the whole measurement is the computed truth of one mounted rendering. Construct: one glyph whose path data varies over TWO enum axes at once (tone x size), every conjunction drawn — the fluent.checkbox indicator shape",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "tone",
      "type": {
        "enum": [
          "plain",
          "marked"
        ]
      },
      "default": "plain",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Tone",
          "values": {
            "plain": "Plain",
            "marked": "Marked"
          }
        },
        "code": {
          "prop": "tone"
        }
      }
    },
    {
      "name": "size",
      "type": {
        "enum": [
          "sm",
          "lg"
        ]
      },
      "default": "sm",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "values": {
            "sm": "Sm",
            "lg": "Lg"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {}
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@ds-contracts/conformance",
        "export": "CaseSvgGlyphTwoAxis"
      }
    }
  }
}
