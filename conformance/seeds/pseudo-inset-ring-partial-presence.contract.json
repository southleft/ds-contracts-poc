  "id": "conformance.pseudo-inset-ring-partial-presence",
  "name": "CasePseudoInsetRingPartialPresence",
  "version": "0.1.0",
  "status": "draft",
  "description": "SEED contract for the CSS/DOM conformance fixture case \"pseudo-inset-ring-partial-presence\" (pseudo-elements). The fixture varies CSS CONSTRUCTS, not prop spaces, so the prop space is deliberately EMPTY: every axis the capture would enumerate is held at nothing, and the whole measurement is the computed truth of one mounted rendering. Construct: the SAME coincident inset ring as pseudo-inset-ring-two-axis, but the ring pseudo EXISTS IN ONLY HALF THE DOMAIN (`[data-size=\"small\"]::after`) while the host carries an opaque per-combo border-colour and zero border width of its own in ALL eight combos",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "appearance",
      "type": {
        "enum": [
          "outline",
          "tint"
        ]
      },
      "default": "outline",
      "bindings": {
