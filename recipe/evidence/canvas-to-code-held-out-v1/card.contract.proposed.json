{
  "$schema": "./contract.schema.json",
  "id": "ds.card",
  "name": "Card",
  "version": "0.1.0",
  "status": "draft",
  "description": "PROPOSED contract extracted from the design canvas (extract/figma dump v1) — API, anatomy, and token bindings inverted from the drawn structure. Semantics beyond the name/axis inference table, a11y, events, and slot accepts are not canvas-recoverable; review before adoption.",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "size",
      "type": {
        "enum": [
          "default",
          "small"
        ]
      },
      "default": "default",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "values": {
            "default": "Default",
            "small": "Small"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "variant",
      "type": {
        "enum": [
          "outlined",
          "borderless"
        ]
      },
      "default": "outlined",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "values": {
            "outlined": "Outlined",
            "borderless": "Borderless"
          }
        },
        "code": {
          "prop": "variant"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "layout": {
        "display": "flex",
        "direction": "column",
        "align": "stretch"
      },
      "parts": {
        "cardHead": {
          "layout": {
            "direction": "column",
            "justify": "center",
            "align": "stretch"
          },
          "tokens": {
            "border-color": "{imported.card.card-head.border-bottom-color}",
            "padding-left": "{imported.card.card-head.padding-left.{size}}",
            "padding-right": "{imported.card.card-head.padding-right.{size}}",
            "min-height": "{imported.card.card-head.min-height.{size}}"
          },
          "parts": {
            "cardHeadWrapper": {
              "layout": {
                "direction": "row",
                "align": "center"
              },
              "parts": {
                "label": {
                  "declared": {
                    "font-family": "Roboto"
                  },
                  "text": "Card title",
                  "tokens": {
                    "color": "{imported.shared.color-000000e0}",
                    "font-size": "{imported.card.label.font-size.{size}}",
                    "font-weight": "{imported.card.card-head-card-head-wrapper-label.font-weight}",
                    "line-height": "{imported.card.card-head-card-head-wrapper-label.line-height}"
                  }
                }
              }
            }
          }
        },
        "label2": {
          "layout": {
            "direction": "row"
          },
          "tokens": {
            "padding-left": "{imported.card.label-2.padding-left.{size}}",
            "padding-right": "{imported.card.label-2.padding-right.{size}}",
            "padding-top": "{imported.card.label-2.padding-top.{size}}",
            "padding-bottom": "{imported.card.label-2.padding-bottom.{size}}"
          },
          "parts": {
            "label2Text": {
              "declared": {
                "font-family": "Roboto"
              },
              "text": "Card body copy for the exam.",
              "tokens": {
                "color": "{imported.shared.color-000000e0}",
                "font-size": "{imported.card.label-2.font-size}",
                "font-weight": "{imported.card.label-2-label-2-text.font-weight}",
                "line-height": "{imported.card.label-2-label-2-text.line-height}"
              }
            }
          }
        }
      },
      "literals": {
        "height": "fit-content"
      },
      "tokens": {
        "background-color": "{imported.card.root.background-color}",
        "border-color": "{imported.card.root.border-top-color.{variant}}",
        "border-radius": "{imported.shared.size-8}",
        "border-width": "{imported.card.root.border-width.{variant}}"
      }
    }
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "src/components/Card",
        "export": "Card"
      }
    }
  }
}
