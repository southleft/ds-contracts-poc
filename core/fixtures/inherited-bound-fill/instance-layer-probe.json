  "probeCode": "\nconst page=figma.createPage();page.name='Bound instance paint 889';await figma.setCurrentPageAsync(page);\nconst collection=figma.variables.createVariableCollection('Probe889');\nconst variable=figma.variables.createVariable('Ink',collection,'COLOR');\nvariable.setValueForMode(collection.defaultModeId,{r:.25,g:.5,b:.75,a:.5});\nconst main=figma.createComponent();page.appendChild(main);main.name='Literal main';main.resize(40,40);\nconst paint={type:'SOLID',color:{r:.25,g:.5,b:.75},opacity:.5,blendMode:'MULTIPLY'};\nmain.fills=[paint];\nconst bound=figma.variables.setBoundVariableForPaint(paint,'color',variable);\nconst direct=main.createInstance();page.appendChild(direct);direct.x=60;direct.name='Bound direct';direct.fills=[bound];\nconst restored=main.createInstance();page.appendChild(restored);restored.x=120;restored.name='Bound then blend';restored.fills=[{...bound,blendMode:'MULTIPLY'}];\nconst layered=figma.createComponent();page.appendChild(layered);layered.x=180;layered.name='Paint layer main';layered.resize(40,40);layered.fills=[];\nconst layer=figma.createRectangle();layered.appendChild(layer);layer.name='Paint';layer.resize(40,40);layer.fills=[paint];layer.constraints={horizontal:'STRETCH',vertical:'STRETCH'};\nconst instance=layered.createInstance();page.appendChild(instance);instance.x=240;instance.name='Layer override';instance.children[0].fills=[bound];instance.children[0].blendMode='MULTIPLY';instance.children[0].opacity=1;\nconst rows=[main,direct,restored,layered,instance].map(n=>({id:n.id,name:n.name,type:n.type,fills:n.fills,children:n.children.map(c=>({id:c.id,fills:c.fills,blendMode:c.blendMode,opacity:c.opacity}))}));\nfigma.viewport.scrollAndZoomIntoView([main,direct,restored,layered,instance]);\nreturn {pageId:page.id,collectionId:collection.id,variableId:variable.id,bound,rows};\n",
  "comparisonCode": "\nconst page=await figma.getNodeByIdAsync('157:67106');await figma.setCurrentPageAsync(page);\nconst main=await figma.getNodeByIdAsync('157:67109'),layered=await figma.getNodeByIdAsync('157:67112'),variable=await figma.variables.getVariableByIdAsync('VariableID:157:67108');\nfor(const m of [main,layered]){const foreground=figma.createRectangle();m.appendChild(foreground);foreground.name='Foreground';foreground.resize(12,12);foreground.x=14;foreground.y=14;foreground.fills=[{type:'SOLID',color:{r:1,g:0,b:0}}];}\nconst frames=[];\nfor(const [i,color]of [{r:1,g:1,b:1},{r:0,g:0,b:0},{r:.8,g:.6,b:.2}].entries())for(const kind of ['literal','layer']){\n const frame=figma.createFrame();page.appendChild(frame);frame.name=kind+'-'+i;frame.resize(40,40);frame.x=i*120+(kind==='layer'?50:0);frame.y=80;frame.fills=[{type:'SOLID',color}];\n const instance=(kind==='literal'?main:layered).createInstance();frame.appendChild(instance);instance.x=0;instance.y=0;\n if(kind==='layer'){const paint=instance.children[0];paint.fills=[figma.variables.setBoundVariableForPaint({type:'SOLID',color:{r:0,g:0,b:0}},'color',variable)];paint.blendMode='MULTIPLY';paint.opacity=1;}\n frames.push({id:frame.id,name:frame.name,instanceId:instance.id,mainId:(await instance.getMainComponentAsync()).id,children:instance.children.map(n=>({id:n.id,name:n.name,fills:n.fills,blendMode:n.blendMode})),png:figma.base64Encode(await frame.exportAsync({format:'PNG'}))});\n}\nfigma.viewport.scrollAndZoomIntoView(frames.map(r=>figma.getNodeById(r.id)));\nreturn {pageId:page.id,frames};\n",
  "scope": "Native feasibility only; no public conversion or reverse qualification."
