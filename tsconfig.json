{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@ds-contracts/core": [
        "./packages/core/src/index.ts"
      ],
      "@ds-contracts/schema": [
        "./packages/schema/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "core",
    ".storybook",
    "extract",
    "parity",
    "sync",
    "evals",
    "conformance",
    // "recipe" is deliberately NOT included: the recipe path's acceptance
    // surface is its gates (recipe:*:check run the code under tsx), its
    // versioned lineage files are byte-frozen receipts that cannot be edited
    // to track checker evolution, and recipe/pivot-status.ts's ~11k-operand
    // boolean chains crash the TypeScript binder outright. The CURRENT recipe
    // surface is typechecked by tsconfig.recipe.json (`npm run typecheck:recipe`,
    // a fast-lane step since 2026-09-02); frozen lineage errors are named there.
    "figma-sync/plugin/engine"
  ],
  "exclude": [
    "conformance/.sandbox",
    "extract/fixtures",
    "evals/.scratch",
    "evals/adherence",
    "evals/fixtures",
    "core/samples"
  ]
}
