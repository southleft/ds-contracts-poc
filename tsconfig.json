{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@ds-contracts/core": [
        "./packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "core",
    ".storybook",
    "extract",
    "parity",
    "sync",
    "evals",
    "conformance",
    "figma-sync/plugin/engine"
  ],
  "exclude": [
    "conformance/.sandbox",
    "extract/fixtures",
    "evals/.scratch",
    "evals/adherence",
    "evals/fixtures",
    "core/samples"
  ]
}
