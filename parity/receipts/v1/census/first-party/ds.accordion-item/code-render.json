        "part": "titleText",
        "prop": "title"
      }
    ],
    "tokenRefs": [
      "border-width.100",
      "color.border.subtle",
      "color.surface.foreground",
      "color.surface.raised",
      "color.text.secondary",
      "font.control.family",
      "font.control.size.sm",
      "font.control.weight",
      "radius.card",
      "size.card.width",
      "space.gap.sm",
      "space.inset-x.sm",
      "space.inset-y.md",
      "state"
    ],
    "icons": [
      "{state}"
    ],
    "events": [
      "toggle"
    ]
  },
  "variants": [
    {
      "slug": "state-closed",
      "variant": "State=Closed",
      "kind": "base",
      "subst": {
        "state": "closed"
