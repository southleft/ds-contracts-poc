{
  "id": "ds.accordion-item",
  "name": "AccordionItem",
  "library": "first-party",
  "contractPath": "contracts/accordion-item.contract.json",
  "contractVersion": "1.1.0",
  "renderer": "core/emit-html.ts via extract/figma/catalog-visual/css-doc.ts buildCssCellDoc + extract/figma/canvas-gate/shots.ts captureCell (600×800, dpr 2, light)",
  "tokenSource": "tokens/ (layered primitives + brand + semantic + light/dark) via src/styles/tokens.css",
  "platform": "darwin/arm64",
  "fontChecks": {
    "Inter": true
  },
  "sample": {
    "rule": "see census-manifest.json sampleRule",
    "cap": {
      "limit": 24,
      "derived": 2,
      "sampled": 2,
      "dropped": 0
    },
    "axisCoverageComplete": true,
    "derivation": "deriveCells"
  },
  "carriedFacts": {
    "props": [
      {
        "name": "state",
        "type": "enum",
