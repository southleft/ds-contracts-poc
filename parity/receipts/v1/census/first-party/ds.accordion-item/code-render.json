    },
    {
      "slug": "state-open",
      "variant": "State=Open",
      "kind": "base",
      "subst": {
        "state": "open"
      },
      "bools": {},
      "interaction": "default",
      "status": "rendered",
      "png": "code-state-open.png",
      "contentBox": {
        "width": 127.06,
        "height": 51
      }
    }
  ],
  "rendered": 2,
  "refused": 0,
  "unavailable": null
