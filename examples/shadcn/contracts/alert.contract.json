      "parts": {
        "label": {
          "text": "Alert title",
          "description": "Promoted from the computed floor (round 4): rendered anatomy div| — this element exists in the real component's DOM; the static layer had no part for it.",
          "declared": {
            "display": "block",
            "text-align": "left"
          },
          "tokens": {
            "font-size": "{imported.shared.size-14}",
            "font-weight": "{imported.alert.label.font-weight}",
            "line-height": "{imported.shared.size-20}"
          },
          "tokensByProp": [
            {
              "prop": "variant",
              "map": {
                "default": {
                  "color": "{imported.alert.label.color.default}"
                },
                "destructive": {
                  "color": "{imported.alert.label.color.destructive}"
                }
              }
            }
