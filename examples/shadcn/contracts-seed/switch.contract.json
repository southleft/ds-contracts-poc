    "element": "button"
  },
  "props": [
    {
      "name": "size",
      "type": {
        "enum": [
          "sm",
          "default"
        ]
      },
      "default": "default",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "values": {
            "sm": "Sm",
            "default": "Default"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "checked",
      "type": {
        "enum": [
          "unchecked",
          "checked"
        ]
      },
      "default": "unchecked",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Checked",
          "values": {
            "unchecked": "Unchecked",
            "checked": "Checked"
          }
        },
        "code": {
          "prop": "checked"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {}
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@shadcn-sandbox/ui",
        "export": "Switch"
      }
    }
  }
}
