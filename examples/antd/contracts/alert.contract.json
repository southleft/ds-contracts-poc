        "enum": [
          "success",
          "info",
          "warning",
          "error"
        ]
      },
      "default": "info",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Type",
          "values": {
            "success": "Success",
            "info": "Info",
            "warning": "Warning",
            "error": "Error"
          }
        },
        "code": {
          "prop": "type"
        }
      }
    },
    {
      "name": "showIcon",
