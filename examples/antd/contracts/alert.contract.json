        "enum": [
          "noIcon",
          "icon"
        ]
      },
      "default": "noIcon",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Show Icon",
          "values": {
            "noIcon": "NoIcon",
            "icon": "Icon"
          }
        },
        "code": {
          "prop": "showIcon"
        }
      }
    },
    {
      "name": "message",
      "type": "text",
      "default": "Alert message",
