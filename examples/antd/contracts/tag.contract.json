              "border-bottom-color": "{imported.tag.root.border-bottom-color.red.{bordered}}",
              "border-left-color": "{imported.tag.root.border-left-color.red.{bordered}}",
              "border-right-color": "{imported.tag.root.border-right-color.red.{bordered}}",
              "border-top-color": "{imported.tag.root.border-top-color.red.{bordered}}",
              "color": "{imported.tag.root.color.red}"
            },
            "success": {
              "background-color": "{imported.tag.root.background-color.success}",
              "border-bottom-color": "{imported.tag.root.border-bottom-color.success.{bordered}}",
              "border-left-color": "{imported.tag.root.border-left-color.success.{bordered}}",
              "border-right-color": "{imported.tag.root.border-right-color.success.{bordered}}",
