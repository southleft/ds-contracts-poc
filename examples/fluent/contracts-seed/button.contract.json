      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Appearance",
          "values": {
            "secondary": "Secondary",
            "primary": "Primary",
            "outline": "Outline",
            "subtle": "Subtle",
            "transparent": "Transparent"
          }
        },
