        "figma": {
          "kind": "VARIANT",
          "property": "Checked",
          "values": {
            "unchecked": "Unchecked",
            "checked": "Checked"
          }
        },
        "code": {
          "prop": "checked"
        }
      }
    },
    {
      "name": "label",
      "type": "text",
