        "font-weight": "{imported.chip.root.font-weight}",
        "line-height": "{imported.chip.root.line-height}",
        "min-height": "{imported.chip.root.min-height}",
        "min-width": "{imported.chip.root.min-width}",
        "outline-color": "{imported.chip.root.outline-color.unset}",
