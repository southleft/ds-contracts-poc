      "type": {
        "enum": [
          "primary",
          "knockout",
          "secondary",
          "bare"
        ]
      },
      "default": "primary",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "variant",
          "values": {
            "primary": "primary",
            "knockout": "knockout",
            "secondary": "secondary",
            "bare": "bare"
          }
        },
        "code": {
          "prop": "variant"
        }
      }
    },
    {
      "name": "isDisabled",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "isDisabled",
          "values": {
            "false": "false",
            "true": "true"
          }
        },
        "code": {
          "prop": "isDisabled"
        }
      }
    },
    {
      "name": "text",
      "type": "text",
      "default": "Label",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "text"
        },
        "code": {
          "prop": "text"
        }
      }
    },
    {
      "name": "hasStartIcon",
      "type": "boolean",
      "default": true,
      "bindings": {
