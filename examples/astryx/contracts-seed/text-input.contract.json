{
  "$schema": "../../../contracts/contract.schema.json",
  "id": "astryx.text-input",
  "name": "TextInput",
  "version": "0.1.0",
  "status": "draft",
  "description": "Astryx TextInput — a labelled single-line text field. Promoted from the Phase-A code extraction of @astryxdesign/core@0.1.6 (MIT, react-tsx adapter, src/TextInput/TextInput.tsx, extracted 2026-07-20 — see examples/astryx/PROVENANCE.md). type/label/size/placeholder and the required/disabled/clear flags are verbatim; description, disabledMessage, labelTooltip, htmlName and isLoading are dropped. value is materialized as a placeholder-backed text field. CODE-SIDE fidelity: structural truth + StyleX token bindings, not the computed pixel floor (Astryx Phase A-2).",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "type",
      "description": "The input type.",
      "type": {
        "enum": [
          "text",
          "password",
          "email"
        ]
      },
      "default": "text",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Type",
          "values": {
            "text": "Text",
            "password": "Password",
            "email": "Email"
          }
        },
        "code": {
          "prop": "type"
        }
      }
    },
    {
      "name": "label",
      "description": "The field label.",
      "type": "text",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Label"
        },
        "code": {
          "prop": "label"
        }
      },
      "required": true,
      "default": "Email"
    },
    {
      "name": "size",
      "description": "The field size.",
      "type": {
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "default": "md",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "values": {
            "sm": "Sm",
            "md": "Md",
            "lg": "Lg"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "placeholder",
      "description": "Placeholder text.",
      "type": "text",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Placeholder"
        },
        "code": {
          "prop": "placeholder"
        }
      },
      "default": "you@example.com"
    },
    {
      "name": "isRequired",
      "description": "Whether the field is required.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Is Required"
        },
        "code": {
          "prop": "isRequired"
        }
      }
    },
    {
      "name": "isDisabled",
      "description": "Whether the field is disabled.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Is Disabled"
        },
        "code": {
          "prop": "isDisabled"
        }
      }
    },
    {
      "name": "hasClear",
      "description": "Whether the field shows a clear button.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Has Clear"
        },
        "code": {
          "prop": "hasClear"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {}
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@astryxdesign/core",
        "export": "TextInput"
      }
    }
  }
}
