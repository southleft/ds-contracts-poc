{
  "$schema": "../../../contracts/contract.schema.json",
  "id": "astryx.token",
  "name": "Token",
  "version": "0.1.0",
  "status": "draft",
  "description": "Astryx Token (Tag/Chip) — a compact labelled chip. Promoted from the Phase-A code extraction of @astryxdesign/core@0.1.6 (MIT, react-tsx adapter, src/Token/Token.tsx, extracted 2026-07-20 — see examples/astryx/PROVENANCE.md). label/size/color and isDisabled are verbatim; href link-mode, description and isLabelHidden are dropped. CODE-SIDE fidelity: structural truth + StyleX token bindings, not the computed pixel floor (Astryx Phase A-2).",
  "semantics": {
    "element": "span"
  },
  "props": [
    {
      "name": "label",
      "description": "Tag label.",
      "type": "text",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Label"
        },
        "code": {
          "prop": "label"
        }
      },
      "required": true,
      "default": "Tag"
    },
    {
      "name": "size",
      "description": "The size of the tag.",
      "type": {
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "default": "md",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "values": {
            "sm": "Sm",
            "md": "Md",
            "lg": "Lg"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "color",
      "description": "The tag color.",
      "type": {
        "enum": [
          "default",
          "red",
          "orange",
          "yellow",
          "green",
          "teal",
          "cyan",
          "blue",
          "purple",
          "pink",
          "gray"
        ]
      },
      "default": "default",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Color",
          "values": {
            "default": "Default",
            "red": "Red",
            "orange": "Orange",
            "yellow": "Yellow",
            "green": "Green",
            "teal": "Teal",
            "cyan": "Cyan",
            "blue": "Blue",
            "purple": "Purple",
            "pink": "Pink",
            "gray": "Gray"
          }
        },
        "code": {
          "prop": "color"
        }
      }
    },
    {
      "name": "isDisabled",
      "description": "Whether the tag is disabled.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Is Disabled"
        },
        "code": {
          "prop": "isDisabled"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {}
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@astryxdesign/core",
        "export": "Token"
      }
    }
  }
}
