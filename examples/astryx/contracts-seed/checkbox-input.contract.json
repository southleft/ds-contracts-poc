{
  "$schema": "../../../contracts/contract.schema.json",
  "id": "astryx.checkbox-input",
  "name": "CheckboxInput",
  "version": "0.1.0",
  "status": "draft",
  "description": "Astryx CheckboxInput — a labelled checkbox form control. Promoted from the Phase-A code extraction of @astryxdesign/core@0.1.6 (MIT, react-tsx adapter, src/CheckboxInput/CheckboxInput.tsx, extracted 2026-07-20 — see examples/astryx/PROVENANCE.md). label/size and the disabled/readOnly/required flags are verbatim; description, disabledMessage, htmlName, isLoading and isLabelHidden are dropped. CODE-SIDE fidelity: structural truth + StyleX token bindings, not the computed pixel floor (Astryx Phase A-2). PHASE-1 READER ROUND (docs/35 §3): the `checked` tri-state axis is added the MUI/antd Checkbox way — one contract enum expanded by the config through $props into the library's own `value: boolean | 'indeterminate'` (CheckboxInput.d.ts:63) — so the captured truth finally carries checked/indeterminate renderings instead of the value:false pin the first capture rode.",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "label",
      "description": "The checkbox label.",
      "type": "text",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Label"
        },
        "code": {
          "prop": "label"
        }
      },
      "required": true,
      "default": "Accept terms"
    },
    {
      "name": "checked",
      "description": "Whether the checkbox is unchecked, checked, or indeterminate (the library's `value: boolean | 'indeterminate'`).",
      "type": {
        "enum": [
          "unchecked",
          "checked",
          "indeterminate"
        ]
      },
      "default": "unchecked",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Checked",
          "values": {
            "unchecked": "Unchecked",
            "checked": "Checked",
            "indeterminate": "Indeterminate"
          }
        },
        "code": {
          "prop": "value"
        }
      }
    },
    {
      "name": "size",
      "description": "The control size.",
      "type": {
        "enum": [
          "sm",
          "md"
        ]
      },
      "default": "md",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "values": {
            "sm": "Sm",
            "md": "Md"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "isDisabled",
      "description": "Whether the checkbox is disabled.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Is Disabled"
        },
        "code": {
          "prop": "isDisabled"
        }
      }
    },
    {
      "name": "isReadOnly",
      "description": "Whether the checkbox is read-only.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Is Read Only"
        },
        "code": {
          "prop": "isReadOnly"
        }
      }
    },
    {
      "name": "isRequired",
      "description": "Whether the checkbox is required.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Is Required"
        },
        "code": {
          "prop": "isRequired"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {}
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@astryxdesign/core",
        "export": "CheckboxInput"
      }
    }
  }
}
