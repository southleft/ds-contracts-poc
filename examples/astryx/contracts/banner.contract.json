{
  "$schema": "../../../contracts/contract.schema.json",
  "id": "astryx.banner",
  "name": "Banner",
  "version": "0.2.0",
  "status": "draft",
  "description": "Astryx Banner — promoted from @astryxdesign/core@0.1.6 (src/Banner/Banner.tsx). Two-part structure: a status header (muted background, status icon, semibold title, supporting description) and an optional collapsible content area (out of scope for the default exhibit). Status backgrounds use accent/warning/error/success *-muted tokens; icons use the vendor defaultIconNames mapping at md (20px).",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "status",
      "description": "Status type controlling the icon and color scheme.",
      "type": {
        "enum": [
          "info",
          "warning",
          "error",
          "success"
        ]
      },
      "default": "info",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Status",
          "values": {
            "info": "Info",
            "warning": "Warning",
            "error": "Error",
            "success": "Success"
          }
        },
        "code": {
          "prop": "status"
        }
      }
    },
    {
      "name": "container",
      "description": "How the banner is contained.",
      "type": {
        "enum": [
          "card",
          "section"
        ]
      },
      "default": "card",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Container",
          "values": {
            "card": "Card",
            "section": "Section"
          }
        },
        "code": {
          "prop": "container"
        }
      }
    },
    {
      "name": "isDismissable",
      "description": "Whether the banner can be dismissed.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Is Dismissable"
        },
        "code": {
          "prop": "isDismissable"
        }
      }
    },
    {
      "name": "title",
      "description": "Title text displayed prominently in the header area.",
      "type": "text",
      "default": "A new software update is available.",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Title"
        },
        "code": {
          "prop": "title"
        }
      }
    },
    {
      "name": "description",
      "description": "Optional supporting text below the title in the header area.",
      "type": "text",
      "default": "See what changed in this version.",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Description"
        },
        "code": {
          "prop": "description"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "layout": {
        "display": "flex",
        "direction": "column"
      },
      "parts": {
        "header": {
          "element": "div",
          "layout": {
            "display": "flex",
            "direction": "row",
            "align": "start"
          },
          "tokens": {
            "gap": "{spacing-2}",
            "padding-block": "{spacing-3}",
            "padding-inline": "{spacing-4}"
          },
          "tokensByProp": [
            {
              "prop": "status",
              "map": {
                "info": {
                  "background-color": "{color-background-blue}"
                },
                "warning": {
                  "background-color": "{color-warning-muted}"
                },
                "error": {
                  "background-color": "{color-error-muted}"
                },
                "success": {
                  "background-color": "{color-success-muted}"
                }
              }
            }
          ],
          "literalsByProp": [
            {
              "prop": "container",
              "map": {
                "card": {
                  "border-radius": "12px"
                },
                "section": {
                  "border-radius": "0"
                }
              }
            }
          ],
          "parts": {
            "iconWrapper": {
              "layout": {
                "display": "flex",
                "align": "center"
              },
              "parts": {
                "iconInfo": {
                  "icon": {
                    "asset": "banner-info",
                    "size": 20
                  },
                  "visibleWhen": {
                    "prop": "status",
                    "equals": "info"
                  },
                  "tokens": {
                    "color": "{color-text-blue}"
                  }
                },
                "iconWarning": {
                  "icon": {
                    "asset": "banner-warning",
                    "size": 20
                  },
                  "visibleWhen": {
                    "prop": "status",
                    "equals": "warning"
                  },
                  "tokens": {
                    "color": "{color-text-yellow}"
                  }
                },
                "iconError": {
                  "icon": {
                    "asset": "banner-error",
                    "size": 20
                  },
                  "visibleWhen": {
                    "prop": "status",
                    "equals": "error"
                  },
                  "tokens": {
                    "color": "{color-text-red}"
                  }
                },
                "iconSuccess": {
                  "icon": {
                    "asset": "banner-success",
                    "size": 20
                  },
                  "visibleWhen": {
                    "prop": "status",
                    "equals": "success"
                  },
                  "tokens": {
                    "color": "{color-text-green}"
                  }
                }
              }
            },
            "headerContent": {
              "layout": {
                "display": "flex",
                "direction": "column",
                "grow": true
              },
              "parts": {
                "title": {
                  "element": "div",
                  "content": {
                    "prop": "title"
                  },
                  "tokens": {
                    "color": "{color-text-primary}",
                    "font-size": "{text-label-size}",
                    "font-weight": "{font-weight-semibold}",
                    "line-height": "{text-label-leading}"
                  },
                  "tokensByProp": [
                    {
                      "prop": "status",
                      "map": {
                        "info": { "color": "{color-text-blue}" },
                        "warning": { "color": "{color-text-yellow}" },
                        "error": { "color": "{color-text-red}" },
                        "success": { "color": "{color-text-green}" }
                      }
                    }
                  ]
                },
                "description": {
                  "element": "div",
                  "content": {
                    "prop": "description"
                  },
                  "tokens": {
                    "color": "{color-text-secondary}",
                    "font-size": "{text-supporting-size}",
                    "font-weight": "{text-supporting-weight}",
                    "line-height": "{text-supporting-leading}"
                  },
                  "tokensByProp": [
                    {
                      "prop": "status",
                      "map": {
                        "info": { "color": "{color-text-blue}" },
                        "warning": { "color": "{color-text-yellow}" },
                        "error": { "color": "{color-text-red}" },
                        "success": { "color": "{color-text-green}" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@astryxdesign/core",
        "export": "Banner"
      }
    }
  }
}
