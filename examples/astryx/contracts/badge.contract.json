{
  "$schema": "../../../contracts/contract.schema.json",
  "id": "astryx.badge",
  "name": "Badge",
  "version": "0.3.0",
  "status": "draft",
  "description": "Astryx Badge — a small status/category label. Promoted from the Phase-A code extraction of @astryxdesign/core@0.1.6 (MIT, react-tsx adapter, src/Badge/Badge.tsx, extracted 2026-07-20 — see examples/astryx/PROVENANCE.md). API surface (variant) is verbatim; the label is materialized as a text content part (Astryx types it as a ReactNode child slot, dropped as a `node` prop in extraction — see DEV-JOURNEY.md). CODE-SIDE fidelity: structural truth + StyleX token bindings, not the computed pixel floor (Astryx Phase A-2). COMPUTED-ENRICHED (extract/computed): unlabeled styled channels minted from computed-style capture of @astryxdesign/core@0.1.6 in headless Chromium 151.0.7922.34; overflow channels in the sibling extension file. FLOOR-PROMOTED (examples/astryx/scripts/promote-floor.ts): resolved.contract.json — computed-capture truth with the decisions ledger applied (extract/computed/out/astryx/badge/decisions.md); extension sidecar carries the named overflow.",
  "archetype": "badge / tag / chip",
  "semantics": {
    "element": "span"
  },
  "props": [
    {
      "name": "variant",
      "description": "The visual style variant of the badge.",
      "type": {
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "error",
          "blue",
          "cyan",
          "green",
          "orange",
          "pink",
          "purple",
          "red",
          "teal",
          "yellow"
        ]
      },
      "default": "neutral",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "values": {
            "neutral": "Neutral",
            "info": "Info",
            "success": "Success",
            "warning": "Warning",
            "error": "Error",
            "blue": "Blue",
            "cyan": "Cyan",
            "green": "Green",
            "orange": "Orange",
            "pink": "Pink",
            "purple": "Purple",
            "red": "Red",
            "teal": "Teal",
            "yellow": "Yellow"
          }
        },
        "code": {
          "prop": "variant"
        }
      }
    },
    {
      "name": "children",
      "description": "Badge label (materialized text slot — Astryx types this as a ReactNode child).",
      "type": "text",
      "default": "New",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Label"
        },
        "code": {
          "prop": "children"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "layout": {
        "display": "flex",
        "align": "center",
        "justify": "center"
      },
      "text": "New",
      "declared": {
        "text-wrap-mode": "nowrap"
      },
      "tokens": {
        "border-bottom-left-radius": "{imported.shared.size-9999}",
        "border-bottom-right-radius": "{imported.shared.size-9999}",
        "border-top-left-radius": "{imported.shared.size-9999}",
        "border-top-right-radius": "{imported.shared.size-9999}",
        "column-gap": "{imported.badge.root.column-gap}",
        "font-size": "{font-size-sm}",
        "font-weight": "{imported.badge.root.font-weight}",
        "line-height": "{imported.badge.root.line-height}",
        "padding-left": "{imported.badge.root.padding-left}",
        "padding-right": "{imported.badge.root.padding-right}",
        "row-gap": "{imported.badge.root.row-gap}",
        "padding-block": "{spacing-0}"
      },
      "tokensByProp": [
        {
          "prop": "variant",
          "map": {
            "blue": {
              "background-color": "{imported.badge.root.background-color.blue}",
              "color": "{imported.badge.root.color.blue}"
            },
            "cyan": {
              "background-color": "{imported.badge.root.background-color.cyan}",
              "color": "{imported.badge.root.color.cyan}"
            },
            "error": {
              "background-color": "{color-error}",
              "color": "{color-on-accent}"
            },
            "green": {
              "background-color": "{imported.badge.root.background-color.green}",
              "color": "{imported.badge.root.color.green}"
            },
            "info": {
              "background-color": "{color-accent}",
              "color": "{color-on-accent}"
            },
            "neutral": {
              "background-color": "{color-neutral}",
              "color": "{imported.badge.root.color.neutral}"
            },
            "orange": {
              "background-color": "{imported.badge.root.background-color.orange}",
              "color": "{imported.badge.root.color.orange}"
            },
            "pink": {
              "background-color": "{imported.badge.root.background-color.pink}",
              "color": "{imported.badge.root.color.pink}"
            },
            "purple": {
              "background-color": "{imported.badge.root.background-color.purple}",
              "color": "{imported.badge.root.color.purple}"
            },
            "red": {
              "background-color": "{imported.badge.root.background-color.red}",
              "color": "{imported.badge.root.color.red}"
            },
            "success": {
              "background-color": "{color-success}",
              "color": "{color-on-accent}"
            },
            "teal": {
              "background-color": "{imported.badge.root.background-color.teal}",
              "color": "{imported.badge.root.color.teal}"
            },
            "warning": {
              "background-color": "{color-warning}",
              "color": "{color-on-warning}"
            },
            "yellow": {
              "background-color": "{imported.badge.root.background-color.yellow}",
              "color": "{imported.badge.root.color.yellow}"
            }
          }
        }
      ]
    }
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@astryxdesign/core",
        "export": "Badge"
      }
    }
  }
}
