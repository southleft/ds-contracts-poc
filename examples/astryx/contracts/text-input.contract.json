{
  "$schema": "../../../contracts/contract.schema.json",
  "id": "astryx.text-input",
  "name": "TextInput",
  "version": "0.2.0",
  "status": "draft",
  "description": "Astryx TextInput — promoted from the Phase-A code extraction of @astryxdesign/core@0.1.6 (MIT, react-tsx adapter, src/TextInput/TextInput.tsx, extracted 2026-07-20 — see examples/astryx/PROVENANCE.md). type/label/size/placeholder and the optional/required/disabled/clear/autofocus flags are verbatim (83% facts-carried); description, disabledMessage, labelTooltip, htmlName and isLoading are dropped. value is materialized as a placeholder-backed text field. Wave B.3: showcase width (320px), inputWrapper border (color-border-emphasized), startIcon row (type-mapped 16px glyphs, color-icon-secondary), and placeholder hierarchy (body-size secondary text) from TextInput.tsx + inputStyles.stylex source — not harness-captured.",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "type",
      "description": "The input type.",
      "type": {
        "enum": [
          "text",
          "password",
          "email"
        ]
      },
      "default": "text",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Type",
          "values": {
            "text": "Text",
            "password": "Password",
            "email": "Email"
          }
        },
        "code": {
          "prop": "type"
        }
      }
    },
    {
      "name": "label",
      "description": "The field label.",
      "type": "text",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Label"
        },
        "code": {
          "prop": "label"
        }
      },
      "required": true,
      "default": "Email"
    },
    {
      "name": "size",
      "description": "The field size.",
      "type": {
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "default": "md",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "values": {
            "sm": "Sm",
            "md": "Md",
            "lg": "Lg"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "placeholder",
      "description": "Placeholder text.",
      "type": "text",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Placeholder"
        },
        "code": {
          "prop": "placeholder"
        }
      },
      "default": "you@example.com"
    },
    {
      "name": "isRequired",
      "description": "Whether the field is required.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Is Required"
        },
        "code": {
          "prop": "isRequired"
        }
      }
    },
    {
      "name": "isDisabled",
      "description": "Whether the field is disabled.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Is Disabled"
        },
        "code": {
          "prop": "isDisabled"
        }
      }
    },
    {
      "name": "hasClear",
      "description": "Whether the field shows a clear button.",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Has Clear"
        },
        "code": {
          "prop": "hasClear"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "layout": {
        "display": "flex",
        "direction": "column"
      },
      "tokens": {
        "color": "{color-text-primary}",
        "gap": "{spacing-1}",
        "font-family": "{font-family-body}",
        "font-size": "{font-size-sm}"
      },
      "literals": {
        "width": "320px"
      },
      "parts": {
        "label": {
          "element": "span",
          "content": {
            "prop": "label"
          },
          "tokens": {
            "color": "{color-text-secondary}",
            "font-size": "{font-size-xs}"
          }
        },
        "field": {
          "element": "div",
          "layout": {
            "display": "flex",
            "direction": "row",
            "align": "center"
          },
          "tokens": {
            "background-color": "{color-background-surface}",
            "border-color": "{color-border-emphasized}",
            "border-width": "{border-width}",
            "border-radius": "{radius-element}",
            "gap": "{spacing-2}",
            "padding-block": "{spacing-2}",
            "padding-inline": "{spacing-3}"
          },
          "tokensByProp": {
            "prop": "size",
            "map": {
              "sm": {
                "padding-block": "{spacing-1}",
                "padding-inline": "{spacing-2}"
              },
              "md": {
                "padding-block": "{spacing-2}",
                "padding-inline": "{spacing-3}"
              },
              "lg": {
                "padding-block": "{spacing-3}",
                "padding-inline": "{spacing-4}"
              }
            }
          },
          "parts": {
            "start-icon": {
              "layout": {
                "display": "flex",
                "align": "center"
              },
              "parts": {
                "icon-text": {
                  "icon": {
                    "asset": "text-input-user",
                    "size": 16
                  },
                  "visibleWhen": {
                    "prop": "type",
                    "equals": "text"
                  },
                  "tokens": {
                    "color": "{color-icon-secondary}"
                  }
                },
                "icon-email": {
                  "icon": {
                    "asset": "text-input-mail",
                    "size": 16
                  },
                  "visibleWhen": {
                    "prop": "type",
                    "equals": "email"
                  },
                  "tokens": {
                    "color": "{color-icon-secondary}"
                  }
                },
                "icon-password": {
                  "icon": {
                    "asset": "text-input-lock",
                    "size": 16
                  },
                  "visibleWhen": {
                    "prop": "type",
                    "equals": "password"
                  },
                  "tokens": {
                    "color": "{color-icon-secondary}"
                  }
                }
              }
            },
            "placeholder-text": {
              "element": "span",
              "content": {
                "prop": "placeholder"
              },
              "tokens": {
                "color": "{color-text-secondary}",
                "font-size": "{font-size-sm}"
              }
            }
          }
        }
      }
    }
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@astryxdesign/core",
        "export": "TextInput"
      }
    }
  }
}
