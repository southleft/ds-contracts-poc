{
  "$schema": "./contract.schema.json",
  "id": "mui.card",
  "name": "Card",
  "version": "0.2.0",
  "status": "draft",
  "description": "SEED contract for the MUI computed-floor round — props/axes only; anatomy is promoted from captured DOM truth (Round 4). Subject: @mui/material@9.2.0 (pinned, examples/mui/PROVENANCE.md). COMPUTED-ENRICHED (extract/computed): unlabeled styled channels minted from computed-style capture of @mui/material@9.2.0 in headless Chromium 149.0.7827.55; overflow channels in the sibling extension file. FLOOR-PROMOTED (examples/mui/scripts/promote-floor.mjs): enriched.contract.json — computed-capture truth; minted leaves source-aliased to MUI's own CSS-variable references where verified (source-bindings.json); extension sidecar carries the named overflow.",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "elevation",
      "type": {
        "enum": [
          "0",
          "1",
          "3",
          "8"
        ]
      },
      "default": "1",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Elevation",
          "values": {
            "0": "0",
            "1": "1",
            "3": "3",
            "8": "8"
          }
        },
        "code": {
          "prop": "elevation"
        }
      }
    },
    {
      "name": "children",
      "type": "text",
      "default": "Card content",
      "description": "Promoted from the computed floor: the mounted children render as this part's text (captured mount proof).",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Content"
        },
        "code": {
          "prop": "children"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "declared": {
        "display": "block",
        "overflow-x": "hidden",
        "overflow-y": "hidden",
        "transition-duration": "0.3s",
        "transition-property": "box-shadow",
        "transition-timing-function": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "parts": {
        "label": {
          "content": {
            "prop": "children"
          },
          "description": "Promoted from the computed floor (round 4): rendered anatomy div|CardContent-root — this element exists in the real component's DOM; the static layer had no part for it.",
          "declared": {
            "display": "block"
          },
          "tokens": {
            "color": "{imported.card.label.color}",
            "font-size": "{imported.shared.size-16}",
            "font-weight": "{imported.card.label.font-weight}",
            "min-height": "{imported.shared.size-0}",
            "min-width": "{imported.shared.size-0}",
            "padding-bottom": "{imported.card.label.padding-bottom}",
            "padding-left": "{imported.shared.size-16}",
            "padding-right": "{imported.shared.size-16}",
            "padding-top": "{imported.shared.size-16}"
          }
        }
      },
      "tokens": {
        "background-color": "{imported.card.root.background-color}",
        "border-bottom-left-radius": "{imported.shared.size-4}",
        "border-bottom-right-radius": "{imported.shared.size-4}",
        "border-top-left-radius": "{imported.shared.size-4}",
        "border-top-right-radius": "{imported.shared.size-4}",
        "color": "{imported.card.root.color}",
        "min-height": "{imported.shared.size-0}",
        "min-width": "{imported.shared.size-0}",
        "width": "{imported.card.root.width}"
      },
      "tokensByProp": [
        {
          "prop": "elevation",
          "map": {
            "0": {
              "box-shadow": "{imported.card.root.box-shadow.0}"
            },
            "1": {
              "box-shadow": "{imported.card.root.box-shadow.1}"
            },
            "3": {
              "box-shadow": "{imported.card.root.box-shadow.3}"
            },
            "8": {
              "box-shadow": "{imported.card.root.box-shadow.8}"
            }
          }
        }
      ]
    }
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@mui/material",
        "export": "Card"
      }
    }
  }
}
