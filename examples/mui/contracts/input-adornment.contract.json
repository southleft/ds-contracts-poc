        "max-height": "{imported.input-adornment.root.max-height}"
      },
      "tokensByProp": [
        {
          "prop": "position",
          "map": {
            "end": {
              "margin-left": "{imported.input-adornment.root.margin-left.end}",
              "margin-right": "{imported.input-adornment.root.margin-right.end}"
            },
