    "element": "div"
  },
  "props": [
    {
      "name": "position",
      "type": {
        "enum": [
          "start",
          "end"
        ]
      },
      "default": "start",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Position",
          "values": {
            "start": "Start",
            "end": "End"
          }
        },
        "code": {
          "prop": "position"
        }
      }
    },
    {
      "name": "children",
      "type": "text",
      "default": "$",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Content"
        },
        "code": {
          "prop": "children"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "layout": {
        "display": "flex",
        "align": "center"
      },
      "parts": {
        "label": {
          "element": "p",
          "content": {
            "prop": "children"
          },
          "description": "Promoted from the computed floor (round 4): rendered anatomy p|Typography-body1.Typography-root — this element exists in the real component's DOM; the static layer had no part for it.",
          "declared": {
            "display": "block",
            "font-family": "Roboto, Helvetica, Arial, sans-serif",
