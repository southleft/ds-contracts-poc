          "kind": "VARIANT",
          "property": "Variant",
          "values": {
            "elevation": "Elevation",
            "outlined": "Outlined"
          }
        },
        "code": { "prop": "variant" }
      }
    }
  ],
  "states": [],
  "anatomy": { "root": {} },
  "anchors": {
    "figma": { "fileKey": null, "componentSetKey": null },
    "code": { "importPath": "@mui/material", "export": "Paper" }
  }
