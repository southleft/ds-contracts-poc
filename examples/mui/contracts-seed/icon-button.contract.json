{
  "$schema": "./contract.schema.json",
  "id": "mui.icon-button",
  "name": "IconButton",
  "version": "0.2.0",
  "status": "draft",
  "description": "SEED contract for the MUI Wave 5 denominator round — bounded size × color cartesian (3×3); disableRipple pinned. Subject: @mui/material@9.2.0 (pinned, examples/mui/PROVENANCE.md).",
  "semantics": {
    "element": "button"
  },
  "props": [
    {
      "name": "size",
      "type": {
        "enum": [
          "small",
          "medium",
          "large"
        ]
      },
      "default": "medium",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "values": {
            "small": "Small",
            "medium": "Medium",
            "large": "Large"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "color",
      "type": {
        "enum": [
          "default",
          "primary",
          "secondary"
        ]
      },
      "default": "default",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Color",
          "values": {
            "default": "Default",
            "primary": "Primary",
            "secondary": "Secondary"
          }
        },
        "code": {
          "prop": "color"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Disabled"
        },
        "code": {
          "prop": "disabled"
        }
      }
    },
    {
      "name": "children",
      "type": "text",
      "default": "★",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Icon"
        },
        "code": {
          "prop": "children"
        }
      }
    }
  ],
  "states": [
    "disabled",
    "hover",
    "focus-visible",
    "active"
  ],
  "anatomy": {
    "root": {}
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@mui/material",
        "export": "IconButton"
      }
    }
  }
}
