# visual-parity artifacts: cached Figma PNGs + per-variant triptychs (the
# worst-10 triptychs are committed under extract/figma/visual-parity/report-assets/)
extract/figma/visual-parity/out/

# built at playground build time (scripts/build-plugin-zip.mjs)
playground/public/ds-contracts-sync-runner-plugin.zip

# live-gauntlet artifacts: cached Figma PNGs + rendered variants (bank once,
# replay offline; manifest is written alongside, also ignored)
extract/figma/gauntlet/live/out/
.gauntlet-live-cache/

# computed-capture floor: transient render surfaces + per-pair screenshots
# (the committed artifacts are the JSON receipts + a few paired receipts)
# NOTE: these are matched at ANY depth under the out root. The literal
# single-level spellings (extract/computed/out/.orig-shots/ and
# .regate-probe.html) missed every NAMESPACED library root — out/mui,
# out/astryx, out/tailwind all take --out, so their transient surfaces were
# untracked churn. Same --out namespacing gap the regate runner had.
extract/computed/out/**/.orig-shots/
extract/computed/out/**/gate-shots/
extract/computed/out/**/.replay-shots/
extract/computed/out/**/gate.html
extract/computed/out/**/replay.html
evals/.computed-replay.html
extract/computed/out/**/.regate-probe.html
# The always-fresh dev-import target — regenerated by npm run plugin:zip
figma-sync/plugin-dist/

# CSS/DOM conformance fixture: the capture harness (symlinks into the repo's own
# node_modules — recreated by conformance/build.ts, never installed from a network)
conformance/.sandbox/

# `ds-contracts onboard` workspace — the two-phase onboarding's scratch state
# (sandbox install, drafted capture config, seed contracts). Everything a run
# should COMMIT lands under the library's own dirs, named by its ds-library.json.
.ds-contracts/
