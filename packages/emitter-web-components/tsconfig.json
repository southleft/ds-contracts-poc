{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@ds-contracts/core": ["../core/src/index.ts"],
      "@ds-contracts/schema": ["../schema/src/index.ts"]
    }
  },
  "include": ["src", "scripts"]
}
