{
  "library": {
    "package": "@mui/material",
    "version": "9.2.0",
    "framework": "react",
    "classPrefix": "Mui",
    "classAllow": "^(?!Mui-)(?!.*-(color|size)[A-Z])(?!.*[a-z]Size[A-Z][A-Za-z]*$)(?!.*-paperWidth[A-Z])(?!.*-tooltipArrow$)(?!.*-popupIndicatorOpen$)(?!.*Collapse-(entered|hidden)$)(?!.*-(text|outlined|contained|filled|elevation)([A-Z][A-Za-z]*|\\d+)?$)(?!.*-(rounded|clickable|deletable)$)Mui",
    "varPrefix": "--mui-"
  },
  "mount": {
    "imports": [
      "import { ThemeProvider, createTheme } from '@mui/material/styles';",
      "const __cssVarsTheme = createTheme({ cssVariables: true, colorSchemes: { light: true } });"
    ],
    "wrapperOpen": "<ThemeProvider theme={__cssVarsTheme}>",
    "wrapperClose": "</ThemeProvider>"
  },
  "tokens": {
    "dtcg": [
      "examples/mui/tokens/mui.dtcg.json"
    ],
    "css": "examples/mui/tokens/mui.vars.css"
  },
  "browser": {
    "viewport": {
      "width": 900,
      "height": 1000
    },
    "deviceScaleFactor": 1,
    "colorScheme": "light"
  },
  "stage": {
    "width": 320,
    "height": 96,
    "padding": 16
  },
  "enumeration": {
    "cartesianLimit": 512,
    "unsetLabel": "__unset"
  },
  "components": [
    {
      "name": "Button",
      "importName": "Button",
      "contract": "examples/mui/contracts-seed/button.contract.json",
      "sampleText": "Button",
      "axes": [
        "variant",
        "color",
        "size"
      ],
      "stateProps": [
        {
          "prop": "disabled",
          "state": "disabled"
        }
      ],
      "fixedProps": {
        "disableRipple": true
      }
    },
    {
      "name": "Chip",
      "importName": "Chip",
      "contract": "examples/mui/contracts-seed/chip.contract.json",
      "sampleText": "Chip",
      "axes": [
        "variant",
        "color",
        "size"
      ],
      "fixedProps": {
        "label": "Chip"
      }
    },
    {
      "name": "Card",
      "importName": "Card",
      "contract": "examples/mui/contracts-seed/card.contract.json",
      "sampleText": "Card content",
      "axes": [
        "elevation"
      ],
      "axisValueMap": {
        "elevation": {
          "0": 0,
          "1": 1,
          "3": 3,
          "8": 8
        }
      },
      "childWrap": {
        "importName": "CardContent"
      },
      "blockStage": true
    },
    {
      "name": "Switch",
      "importName": "Switch",
      "contract": "examples/mui/contracts-seed/switch.contract.json",
      "sampleText": "",
      "axes": [
        "color",
        "size"
      ],
      "stateProps": [
        {
          "prop": "checked",
          "state": "checked"
        },
        {
          "prop": "disabled",
          "state": "disabled"
        }
      ],
      "fixedProps": {
        "disableRipple": true
      }
    },
    {
      "name": "Slider",
      "importName": "Slider",
      "contract": "examples/mui/contracts-seed/slider.contract.json",
      "sampleText": "",
      "axes": [
        "color",
        "size"
      ],
      "fixedProps": {
        "value": 40
      },
      "callbackProps": [
        "onChange"
      ]
    },
    {
      "name": "Tabs",
      "importName": "Tabs",
      "contract": "examples/mui/contracts-seed/tabs.contract.json",
      "sampleText": "",
      "axes": [
        "textColor",
        "indicatorColor"
      ],
      "fixedProps": {
        "value": 0
      },
      "callbackProps": [
        "onChange"
      ],
      "childrenSpec": [
        { "importName": "Tab", "props": { "label": "Overview", "disableRipple": true } },
        { "importName": "Tab", "props": { "label": "Activity", "disableRipple": true } },
        { "importName": "Tab", "props": { "label": "Settings", "disableRipple": true } }
      ]
    },
    {
      "name": "Accordion",
      "importName": "Accordion",
      "contract": "examples/mui/contracts-seed/accordion.contract.json",
      "sampleText": "",
      "axes": [
        "variant",
        "expanded"
      ],
      "axisValueMap": {
        "expanded": {
          "collapsed": false,
          "expanded": true
        }
      },
      "stateProps": [
        {
          "prop": "disabled",
          "state": "disabled"
        }
      ],
      "childrenSpec": [
        { "importName": "AccordionSummary", "text": "Accordion title" },
        { "importName": "AccordionDetails", "text": "Details body copy for the molecule round." }
      ],
      "blockStage": true,
      "stage": { "width": 320, "height": 220, "padding": 16 }
    },
    {
      "name": "Autocomplete",
      "importName": "Autocomplete",
      "contract": "examples/mui/contracts-seed/autocomplete.contract.json",
      "sampleText": "",
      "axes": [
        "size"
      ],
      "fixedProps": {
        "multiple": true,
        "options": ["Alpha", "Beta", "Gamma", "Delta"],
        "value": ["Alpha", "Beta"],
        "renderInput": { "$render": "@mui/material#TextField" }
      },
      "callbackProps": [
        "onChange"
      ],
      "blockStage": true,
      "stage": { "width": 320, "height": 140, "padding": 16 }
    },
    {
      "name": "Tooltip",
      "importName": "Tooltip",
      "contract": "examples/mui/contracts-seed/tooltip.contract.json",
      "sampleText": "Anchor",
      "axes": [],
      "portalCapture": true,
      "openDriver": {
        "open": true,
        "title": "Tooltip text"
      },
      "presenceProps": [
        {
          "prop": "arrow",
          "libraryProp": "arrow",
          "value": true
        }
      ],
      "childWrap": {
        "importName": "Button"
      }
    },
    {
      "name": "Menu",
      "importName": "Menu",
      "contract": "examples/mui/contracts-seed/menu.contract.json",
      "sampleText": "",
      "axes": [],
      "portalCapture": true,
      "openDriver": {
        "open": true,
        "anchorReference": "anchorPosition",
        "anchorPosition": { "top": 24, "left": 24 },
        "transitionDuration": 0
      },
      "callbackProps": [
        "onClose"
      ],
      "childrenSpec": [
        { "importName": "MenuItem", "props": { "disableRipple": true }, "text": "Profile" },
        { "importName": "MenuItem", "props": { "disableRipple": true }, "text": "My account" },
        { "importName": "MenuItem", "props": { "disableRipple": true }, "text": "Log out" }
      ]
    },
    {
      "name": "Dialog",
      "importName": "Dialog",
      "contract": "examples/mui/contracts-seed/dialog.contract.json",
      "sampleText": "Dialog body copy for the molecule round.",
      "axes": [
        "maxWidth"
      ],
      "portalCapture": true,
      "openDriver": {
        "open": true
      },
      "fixedProps": {
        "transitionDuration": 0
      },
      "callbackProps": [
        "onClose"
      ],
      "childWrap": {
        "importName": "DialogContent"
      }
    }
  ]
}
