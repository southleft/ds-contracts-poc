{
  "library": {
    "package": "@mui/material",
    "version": "9.2.0",
    "framework": "react",
    "classPrefix": "Mui",
    "classAllow": "^(?!Mui-)(?!.*-(color|size)[A-Z])(?!.*[a-z]Size[A-Z][A-Za-z]*$)(?!.*-paperWidth[A-Z])(?!.*-tooltipArrow$)(?!.*-popupIndicatorOpen$)(?!.*Collapse-(entered|hidden)$)(?!.*-stickyHeader$)(?!.*-direction[A-Z][A-Za-z]*$)(?!.*-(text|outlined|contained|filled|standard|elevation)([A-Z][A-Za-z]*|\\d+)?$)(?!.*-(rounded|clickable|deletable)$)Mui",
    "varPrefix": "--mui-"
  },
  "mount": {
    "imports": [
      "import { ThemeProvider, createTheme } from '@mui/material/styles';",
      "const __cssVarsTheme = createTheme({ cssVariables: true, colorSchemes: { light: true } });"
    ],
    "wrapperOpen": "<ThemeProvider theme={__cssVarsTheme}>",
    "wrapperClose": "</ThemeProvider>"
  },
  "tokens": {
    "dtcg": [
      "examples/mui/tokens/mui.dtcg.json"
    ],
    "css": "examples/mui/tokens/mui.vars.css"
  },
  "browser": {
    "viewport": {
      "width": 900,
      "height": 1000
    },
    "deviceScaleFactor": 1,
    "colorScheme": "light"
  },
  "stage": {
    "width": 320,
    "height": 96,
    "padding": 16
  },
  "enumeration": {
    "cartesianLimit": 512,
    "unsetLabel": "__unset"
  },
  "components": [
    {
      "name": "Button",
      "importName": "Button",
      "contract": "examples/mui/contracts-seed/button.contract.json",
      "sampleText": "Button",
      "axes": [
        "variant",
        "color",
        "size"
      ],
      "stateProps": [
        {
          "prop": "disabled",
          "state": "disabled"
        }
      ],
      "fixedProps": {
        "disableRipple": true
      }
    },
    {
      "name": "Chip",
      "importName": "Chip",
      "contract": "examples/mui/contracts-seed/chip.contract.json",
      "sampleText": "Chip",
      "axes": [
        "variant",
        "color",
        "size"
      ],
      "fixedProps": {
        "label": "Chip"
      }
    },
    {
      "name": "Card",
      "importName": "Card",
      "contract": "examples/mui/contracts-seed/card.contract.json",
      "sampleText": "Card content",
      "axes": [
        "elevation"
      ],
      "axisValueMap": {
        "elevation": {
          "0": 0,
          "1": 1,
          "3": 3,
          "8": 8
        }
      },
      "childWrap": {
        "importName": "CardContent"
      },
      "blockStage": true
    },
    {
      "__note": "STATE-PLANE PROJECTION ROUND — `checked` RECLASSIFIED from a stateProp to a VARIANT AXIS (the Checkbox/Accordion precedent). `checked` is not a pseudo-class plane: it is a rendering a PROP selects, and it was outside the closed state vocabulary, so its captured deltas minted `<channel>-state-checked` names that re-parsed as nothing and that no emitter rendered. As an axis the same deltas become BASE-PLANE per-axis facts, the Figma variant grid picks the axis up, and the checked thumb's translate rides the overlay-cluster synthetic translate-x/y door.",
      "name": "Switch",
      "importName": "Switch",
      "contract": "examples/mui/contracts-seed/switch.contract.json",
      "sampleText": "",
      "axes": [
        "color",
        "size",
        "checked"
      ],
      "axisValueMap": {
        "checked": {
          "unchecked": false,
          "checked": true
        }
      },
      "stateProps": [
        {
          "prop": "disabled",
          "state": "disabled"
        }
      ],
      "fixedProps": {
        "disableRipple": true
      }
    },
    {
      "name": "Slider",
      "importName": "Slider",
      "contract": "examples/mui/contracts-seed/slider.contract.json",
      "sampleText": "",
      "axes": [
        "color",
        "size"
      ],
      "fixedProps": {
        "value": 40
      },
      "callbackProps": [
        "onChange"
      ]
    },
    {
      "name": "Tabs",
      "importName": "Tabs",
      "contract": "examples/mui/contracts-seed/tabs.contract.json",
      "sampleText": "",
      "axes": [
        "textColor",
        "indicatorColor"
      ],
      "fixedProps": {
        "value": 0
      },
      "callbackProps": [
        "onChange"
      ],
      "childrenSpec": [
        { "importName": "Tab", "props": { "label": "Overview", "disableRipple": true } },
        { "importName": "Tab", "props": { "label": "Activity", "disableRipple": true } },
        { "importName": "Tab", "props": { "label": "Settings", "disableRipple": true } }
      ]
    },
    {
      "name": "Accordion",
      "importName": "Accordion",
      "contract": "examples/mui/contracts-seed/accordion.contract.json",
      "sampleText": "",
      "axes": [
        "variant",
        "expanded"
      ],
      "axisValueMap": {
        "expanded": {
          "collapsed": false,
          "expanded": true
        }
      },
      "stateProps": [
        {
          "prop": "disabled",
          "state": "disabled"
        }
      ],
      "childrenSpec": [
        { "importName": "AccordionSummary", "text": "Accordion title" },
        { "importName": "AccordionDetails", "text": "Details body copy for the molecule round." }
      ],
      "blockStage": true,
      "stage": { "width": 320, "height": 220, "padding": 16 }
    },
    {
      "name": "Autocomplete",
      "importName": "Autocomplete",
      "contract": "examples/mui/contracts-seed/autocomplete.contract.json",
      "sampleText": "",
      "axes": [
        "size"
      ],
      "fixedProps": {
        "multiple": true,
        "options": ["Alpha", "Beta", "Gamma", "Delta"],
        "value": ["Alpha", "Beta"],
        "renderInput": { "$render": "@mui/material#TextField" }
      },
      "callbackProps": [
        "onChange"
      ],
      "blockStage": true,
      "stage": { "width": 320, "height": 140, "padding": 16 }
    },
    {
      "name": "Tooltip",
      "importName": "Tooltip",
      "contract": "examples/mui/contracts-seed/tooltip.contract.json",
      "sampleText": "Anchor",
      "axes": [],
      "portalCapture": true,
      "openDriver": {
        "open": true,
        "title": "Tooltip text"
      },
      "presenceProps": [
        {
          "prop": "arrow",
          "libraryProp": "arrow",
          "value": true
        }
      ],
      "childWrap": {
        "importName": "Button"
      }
    },
    {
      "name": "Menu",
      "importName": "Menu",
      "contract": "examples/mui/contracts-seed/menu.contract.json",
      "sampleText": "",
      "axes": [],
      "portalCapture": true,
      "openDriver": {
        "open": true,
        "anchorReference": "anchorPosition",
        "anchorPosition": { "top": 24, "left": 24 },
        "transitionDuration": 0
      },
      "callbackProps": [
        "onClose"
      ],
      "childrenSpec": [
        { "importName": "MenuItem", "props": { "disableRipple": true }, "text": "Profile" },
        { "importName": "MenuItem", "props": { "disableRipple": true }, "text": "My account" },
        { "importName": "MenuItem", "props": { "disableRipple": true }, "text": "Log out" }
      ]
    },
    {
      "name": "Dialog",
      "importName": "Dialog",
      "contract": "examples/mui/contracts-seed/dialog.contract.json",
      "sampleText": "Dialog body copy for the molecule round.",
      "axes": [
        "maxWidth"
      ],
      "portalCapture": true,
      "openDriver": {
        "open": true
      },
      "fixedProps": {
        "transitionDuration": 0
      },
      "callbackProps": [
        "onClose"
      ],
      "childWrap": {
        "importName": "DialogContent"
      }
    },
    {
      "__note": "ORGANISM ROUND — Checkbox. Tri-state on ONE axis: MUI spells the tri-state as TWO independent booleans (checked + indeterminate), but the svg-content promotion carries per-value glyph assets only when the markup is a function of exactly ONE axis (svg-content-multi-axis refusal otherwise) — so the axis value expands into several library props through the $props grammar. All THREE glyphs (unchecked box, checked box, indeterminate dash) become distinct assets. disableRipple pinned (the Button/Switch precedent — the ripple never settles).",
      "name": "Checkbox",
      "importName": "Checkbox",
      "contract": "examples/mui/contracts-seed/checkbox.contract.json",
      "sampleText": "",
      "axes": [
        "checked"
      ],
      "axisValueMap": {
        "checked": {
          "unchecked": { "$props": { "checked": false } },
          "checked": { "$props": { "checked": true } },
          "indeterminate": { "$props": { "checked": false, "indeterminate": true } }
        }
      },
      "stateProps": [
        {
          "prop": "disabled",
          "state": "disabled"
        }
      ],
      "fixedProps": {
        "disableRipple": true
      }
    },
    {
      "__note": "ORGANISM ROUND — TablePagination (component='div', the composition every real table ships). count/rowsPerPage/page pinned so the rendered text is deterministic ('1–3 of 3'). The rows-per-page Select is pinned CONTROLLED-CLOSED (slotProps.select.open=false): the census active-driver's mouse.down lands on it, opens the MUI menu, and the select icon's 180° open rotation PERSISTED into the next sweep — a witnessed double-run byte-identity refusal (same determinism-pin class as Menu/Dialog transitionDuration:0). NAMED RESIDUE: at count=3 / rowsPerPage=10 / page=0 BOTH arrow IconButtons are forced Mui-disabled by the component itself — the ENABLED arrow colors are unobservable at this combo and are NOT in the captured truth (a paging axis would need a second fixed combo; deliberately out of v1).",
      "name": "Pagination",
      "importName": "TablePagination",
      "contract": "examples/mui/contracts-seed/pagination.contract.json",
      "sampleText": "",
      "axes": [],
      "fixedProps": {
        "component": "div",
        "count": 3,
        "rowsPerPage": 10,
        "page": 0,
        "slotProps": { "select": { "open": false } }
      },
      "callbackProps": [
        "onPageChange",
        "onRowsPerPageChange"
      ],
      "blockStage": true,
      "stage": { "width": 460, "height": 120, "padding": 16 }
    },
    {
      "__note": "ORGANISM ROUND — the composed DataTable, the first ORGANISM through the pipeline. NAMED EXCLUSIONS (v1): (1) stickyHeader is NOT captured — position:sticky has no carried spelling (contract-schema position = relative|static|absolute) and the sticky header also flips border-collapse to separate and paints its own background; (2) the row overflow MENU is captured CLOSED — an open Menu portals a root to document.body and the single-portaled-root policy would DROP the in-stage table; (3) TableSortLabel carries direction='asc' only — the direction axis is excluded by name (the -directionAsc/-directionDesc classes are also excluded from classAllow so a stray axis can never branch the union); (4) TableContainer/Paper is NOT the captured root — enumerated axes ride the ROOT mount and `size` is a Table prop, so the organism IS the Table (Paper elevation is already a captured component this round); (5) rows are INLINED, not component refs — promotion emits no component/repeat/slot refs, and MUI's size='small' descendant rule restyles the nested Checkbox's own padding (42x42 -> 24x24) with UNCHANGED child classes, so composing the standalone Checkbox contract would be WRONG in small tables; (6) TWO body rows, not three — repeated siblings are separate parts under a GLOBAL naming counter (label, label-2, ...), so the sample is the minimum that proves both the plain and the selected/checked row; (7) the row-action control carries a TEXT glyph, not an icon asset — the childrenSpec grammar mounts imported COMPONENTS and @mui/icons-material is not in the pinned sandbox; raw SVG markup in config is deliberately NOT invented this round.",
      "name": "Table",
      "importName": "Table",
      "contract": "examples/mui/contracts-seed/table.contract.json",
      "sampleText": "",
      "axes": [
        "size"
      ],
      "blockStage": true,
      "stage": { "width": 720, "height": 360, "padding": 16 },
      "childrenSpec": [
        {
          "importName": "TableHead",
          "children": [
            {
              "importName": "TableRow",
              "children": [
                { "importName": "TableCell", "props": { "padding": "checkbox" }, "children": [
                  { "importName": "Checkbox", "props": { "indeterminate": true, "disableRipple": true } }
                ] },
                { "importName": "TableCell", "props": { "sortDirection": "asc" }, "children": [
                  { "importName": "TableSortLabel", "props": { "active": true, "direction": "asc" }, "text": "Name" }
                ] },
                { "importName": "TableCell", "text": "Role" },
                { "importName": "TableCell", "text": "Team" },
                { "importName": "TableCell", "props": { "align": "right" }, "text": "Actions" }
              ]
            }
          ]
        },
        {
          "importName": "TableBody",
          "children": [
            {
              "importName": "TableRow",
              "children": [
                { "importName": "TableCell", "props": { "padding": "checkbox" }, "children": [
                  { "importName": "Checkbox", "props": { "checked": false, "disableRipple": true } }
                ] },
                { "importName": "TableCell", "text": "Frozen yoghurt" },
                { "importName": "TableCell", "text": "Designer" },
                { "importName": "TableCell", "text": "Platform" },
                { "importName": "TableCell", "props": { "align": "right" }, "children": [
                  { "importName": "IconButton", "props": { "size": "small", "disableRipple": true, "aria-label": "row actions" }, "text": "⋮" }
                ] }
              ]
            },
            {
              "importName": "TableRow",
              "props": { "selected": true },
              "children": [
                { "importName": "TableCell", "props": { "padding": "checkbox" }, "children": [
                  { "importName": "Checkbox", "props": { "checked": true, "disableRipple": true } }
                ] },
                { "importName": "TableCell", "text": "Ice cream sandwich" },
                { "importName": "TableCell", "text": "Engineer" },
                { "importName": "TableCell", "text": "Contracts" },
                { "importName": "TableCell", "props": { "align": "right" }, "children": [
                  { "importName": "IconButton", "props": { "size": "small", "disableRipple": true, "aria-label": "row actions" }, "text": "⋮" }
                ] }
              ]
            }
          ]
        }
      ]
    }
  ]
}
