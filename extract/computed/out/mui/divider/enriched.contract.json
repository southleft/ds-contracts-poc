{
  "$schema": "./contract.schema.json",
  "id": "mui.divider",
  "name": "Divider",
  "version": "0.1.0",
  "status": "draft",
  "description": "SEED contract for the MUI 50% denominator round — props/axes only; anatomy is promoted from captured DOM truth. Orientation held fixed at horizontal (block stage): a vertical divider needs a flex parent with height, which conflicts with the block stage an <hr> needs for full-bleed width. Subject: @mui/material@9.2.0 (pinned, examples/mui/PROVENANCE.md). COMPUTED-ENRICHED (extract/computed): unlabeled styled channels minted from computed-style capture of @mui/material@9.2.0 in headless Chromium 151.0.7922.34; overflow channels in the sibling extension file.",
  "semantics": {
    "element": "hr"
  },
  "props": [
    {
      "name": "variant",
      "type": {
        "enum": [
          "fullWidth",
          "inset",
          "middle"
        ]
      },
      "default": "fullWidth",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "values": {
            "fullWidth": "FullWidth",
            "inset": "Inset",
            "middle": "Middle"
          }
        },
        "code": {
          "prop": "variant"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "declared": {
        "display": "block",
        "border-bottom-style": "solid",
        "border-left-style": "solid",
        "border-right-style": "solid",
        "border-top-style": "solid",
        "overflow-x": "hidden",
        "overflow-y": "hidden"
      },
      "tokens": {
        "border-bottom-color": "{imported.shared.color-0000001f}",
        "border-bottom-width": "{imported.divider.root.border-bottom-width}",
        "border-left-color": "{imported.shared.color-0000001f}",
        "border-right-color": "{imported.shared.color-0000001f}",
        "border-top-color": "{imported.shared.color-0000001f}",
        "color": "{imported.divider.root.color}",
        "flex-shrink": "{imported.divider.root.flex-shrink}",
        "min-height": "{imported.divider.root.min-height}",
        "min-width": "{imported.divider.root.min-width}"
      },
      "tokensByProp": [
        {
          "prop": "variant",
          "map": {
            "fullWidth": {
              "margin-left": "{imported.divider.root.margin-left.fullWidth}",
              "margin-right": "{imported.divider.root.margin-right.fullWidth}",
              "width": "{imported.divider.root.width.fullWidth}"
            },
            "inset": {
              "margin-left": "{imported.divider.root.margin-left.inset}",
              "margin-right": "{imported.divider.root.margin-right.inset}",
              "width": "{imported.divider.root.width.inset}"
            },
            "middle": {
              "margin-left": "{imported.divider.root.margin-left.middle}",
              "margin-right": "{imported.divider.root.margin-right.middle}",
              "width": "{imported.divider.root.width.middle}"
            }
          }
        }
      ]
    }
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@mui/material",
        "export": "Divider"
      }
    }
  }
}
