{
  "$schema": "./contract.schema.json",
  "id": "mui.avatar",
  "name": "Avatar",
  "version": "0.2.0",
  "status": "draft",
  "description": "SEED contract for the MUI Wave 5 denominator round — props/axes only; anatomy is promoted from captured DOM truth. Variant axis only (circular|rounded|square); initials children pinned via sampleText. Subject: @mui/material@9.2.0 (pinned, examples/mui/PROVENANCE.md). COMPUTED-ENRICHED (extract/computed): unlabeled styled channels minted from computed-style capture of @mui/material@9.2.0 in headless Chromium 149.0.7827.55; overflow channels in the sibling extension file.",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "variant",
      "type": {
        "enum": [
          "circular",
          "rounded",
          "square"
        ]
      },
      "default": "circular",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "values": {
            "circular": "Circular",
            "rounded": "Rounded",
            "square": "Square"
          }
        },
        "code": {
          "prop": "variant"
        }
      }
    },
    {
      "name": "children",
      "type": "text",
      "default": "A",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Initials"
        },
        "code": {
          "prop": "children"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "layout": {
        "display": "flex",
        "align": "center",
        "justify": "center"
      },
      "content": {
        "prop": "children"
      },
      "declared": {
        "box-sizing": "border-box",
        "font-family": "Roboto, Helvetica, Arial, sans-serif",
        "overflow-x": "hidden",
        "overflow-y": "hidden",
        "position": "relative",
        "user-select": "none"
      },
      "tokens": {
        "background-color": "{imported.avatar.root.background-color}",
        "bottom": "{imported.shared.size-0}",
        "color": "{imported.avatar.root.color}",
        "flex-shrink": "{imported.avatar.root.flex-shrink}",
        "font-size": "{imported.avatar.root.font-size}",
        "font-weight": "{imported.avatar.root.font-weight}",
        "left": "{imported.shared.size-0}",
        "letter-spacing": "{imported.avatar.root.letter-spacing}",
        "line-height": "{imported.avatar.root.line-height}",
        "right": "{imported.shared.size-0}",
        "top": "{imported.shared.size-0}"
      },
      "tokensByProp": [
        {
          "prop": "variant",
          "map": {
            "circular": {
              "border-bottom-left-radius": "{imported.avatar.root.border-bottom-left-radius.circular}",
              "border-bottom-right-radius": "{imported.avatar.root.border-bottom-right-radius.circular}",
              "border-top-left-radius": "{imported.avatar.root.border-top-left-radius.circular}",
              "border-top-right-radius": "{imported.avatar.root.border-top-right-radius.circular}"
            },
            "rounded": {
              "border-bottom-left-radius": "{imported.avatar.root.border-bottom-left-radius.rounded}",
              "border-bottom-right-radius": "{imported.avatar.root.border-bottom-right-radius.rounded}",
              "border-top-left-radius": "{imported.avatar.root.border-top-left-radius.rounded}",
              "border-top-right-radius": "{imported.avatar.root.border-top-right-radius.rounded}"
            },
            "square": {
              "border-bottom-left-radius": "{imported.avatar.root.border-bottom-left-radius.square}",
              "border-bottom-right-radius": "{imported.avatar.root.border-bottom-right-radius.square}",
              "border-top-left-radius": "{imported.avatar.root.border-top-left-radius.square}",
              "border-top-right-radius": "{imported.avatar.root.border-top-right-radius.square}"
            }
          }
        }
      ]
    }
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "@mui/material",
        "export": "Avatar"
      }
    }
  }
}
