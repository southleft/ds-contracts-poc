                    "display": "flex",
                    "grow": true,
                    "align": "center",
                    "justify": "center"
                  },
                  "parts": {
                    "icon-info": {
                      "icon": {
                        "asset": "banner-icon-info",
                        "size": 20
                      },
                      "visibleWhen": {
                        "prop": "status",
                        "equals": "info"
                      },
                      "description": "Per-value svg content promoted from the computed floor: the glyph drawn when status=info."
                    },
                    "icon-warning": {
