          "border-left-color": "{imported.button.root.border-left-color-state-focus-visible.{variant}}",
          "border-right-color": "{imported.button.root.border-right-color-state-focus-visible.{variant}}",
          "border-top-color": "{imported.button.root.border-top-color-state-focus-visible.{variant}}",
          "box-shadow": "{imported.button.root.box-shadow-state-focus-visible.{variant}}",
          "outline-width": "{imported.button.root.outline-width-state-focus-visible}"
        },
        "hover": {
          "background-color": "{imported.button.root.background-color-state-hover.{variant}}"
        }
      },
      "tokensByProp": [
        {
          "prop": "size",
          "map": {
            "default": {
              "font-size": "{imported.button.root.font-size.default}",
              "line-height": "{imported.button.root.line-height.default}",
              "padding-left": "{imported.button.root.padding-left.default}",
              "padding-right": "{imported.button.root.padding-right.default}"
            },
