{
  "$schema": "./contract.schema.json",
  "id": "shadcn.button",
  "name": "Button",
  "version": "0.1.0",
  "status": "draft",
  "description": "SEED contract for the SHADCN round — props/axes only; anatomy is promoted from captured DOM truth. Subject: shadcn registry defaults vendored via CLI 4.16.2 (radix-vega, sha256 ledger in examples/shadcn/RECON.md §2.2), mounted through the @shadcn-sandbox/ui barrel (RECON §2.1).  COMPUTED-ENRICHED (extract/computed): unlabeled styled channels minted from computed-style capture of @shadcn-sandbox/ui@0.0.1 in headless Chromium 151.0.7922.34; overflow channels in the sibling extension file.",
  "semantics": {
    "element": "button"
  },
  "props": [
    {
      "name": "variant",
      "type": {
        "enum": [
          "default",
          "outline",
          "secondary",
          "ghost",
          "destructive",
          "link"
        ]
      },
      "default": "default",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "values": {
            "default": "Default",
            "outline": "Outline",
            "secondary": "Secondary",
            "ghost": "Ghost",
            "destructive": "Destructive",
            "link": "Link"
          }
        },
        "code": {
          "prop": "variant"
        }
      }
    },
    {
      "name": "size",
      "type": {
        "enum": [
          "default",
          "xs",
          "sm",
          "lg",
          "icon",
          "icon-xs",
          "icon-sm",
          "icon-lg"
        ]
      },
      "default": "default",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "values": {
            "default": "Default",
            "xs": "Xs",
            "sm": "Sm",
            "lg": "Lg",
            "icon": "Icon",
            "icon-xs": "Icon Xs",
            "icon-sm": "Icon Sm",
            "icon-lg": "Icon Lg"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "asChild",
      "type": "boolean",
      "default": false,
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "As Child"
        },
        "code": {
          "prop": "asChild"
        }
      }
    },
    {
      "name": "children",
      "type": "text",
      "default": "Button",
      "description": "Promoted from the computed floor: the root renders its children as direct text (captured mount proof).",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Content"
        },
        "code": {
          "prop": "children"
        }
      }
    }
  ],
  "states": [
    "active",
    "disabled",
    "focus-visible",
    "hover"
  ],
  "anatomy": {
    "root": {
      "layout": {
        "display": "flex",
        "align": "center",
        "justify": "center"
      },
      "content": {
        "prop": "children"
      },
      "declared": {
        "background-clip": "padding-box",
        "border-bottom-style": "solid",
        "border-left-style": "solid",
        "border-right-style": "solid",
        "border-top-style": "solid",
        "text-wrap-mode": "nowrap",
        "transition-duration": "0.15s",
        "transition-timing-function": "cubic-bezier(0.4, 0, 0.2, 1)",
        "user-select": "none"
      },
      "declaredStates": {
        "active": {
          "translate": "0px 1px"
        },
        "disabled": {
          "pointer-events": "none"
        }
      },
      "tokens": {
        "border-bottom-left-radius": "{imported.shared.size-8}",
        "border-bottom-right-radius": "{imported.shared.size-8}",
        "border-bottom-width": "{imported.shared.size-1}",
        "border-left-width": "{imported.shared.size-1}",
        "border-right-width": "{imported.shared.size-1}",
        "border-top-left-radius": "{imported.shared.size-8}",
        "border-top-right-radius": "{imported.shared.size-8}",
        "border-top-width": "{imported.shared.size-1}",
        "flex-shrink": "{imported.button.root.flex-shrink}",
        "font-weight": "{imported.button.root.font-weight}"
      },
      "states": {
        "active": {
          "background-color": "{imported.button.root.background-color-state-active.{variant}}"
        },
        "disabled": {
          "opacity": "{imported.button.root.opacity-state-disabled}"
        },
        "focus-visible": {
