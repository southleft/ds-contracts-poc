{
  "$schema": "./contract.schema.json",
  "id": "altitude.heading",
  "name": "Heading",
  "version": "0.1.0",
  "status": "draft",
  "description": "SEED contract for the ALTITUDE round — props/axes only; anatomy is promoted from captured DOM truth. Subject: altitude-web-components@1.0.2 (published npm, Lit 3, SHADOW DOM), pinned in examples/altitude/.altitude-sandbox (examples/altitude/PROVENANCE.md). EVERY enum in this library is DEFAULTLESS — the default rendering is the ABSENCE of the attribute (there is no `variant=\"primary\"`; primary IS unset), so every axis leads with the `unset` pseudo-value. No `disabled` state plane: Altitude never reaches the `:disabled` pseudo-class from a prop on these components (al-button's isDisabled emits aria-disabled ONLY — measured identical background, cursor and opacity — and the other seven spell it as an `al-is-disabled` class, which is a prop-selected RENDERING, i.e. a variant axis, not a pseudo-class plane). al-heading. `tagName` EXCLUDED BY NAME: it is a SEMANTIC axis (h1..h6), not a visual one — and it SHADOWS the built-in `Element.prototype.tagName`, so on every instance `el.tagName` reads 'h2' instead of 'AL-HEADING'. Held at its default (h2, the only defaulted enum in the library). COMPUTED-ENRICHED (extract/computed): unlabeled styled channels minted from computed-style capture of altitude-web-components@1.0.2 in headless Chromium 149.0.7827.55; overflow channels in the sibling extension file.",
  "semantics": {
    "element": "h2"
  },
  "props": [
    {
      "name": "variant",
      "type": {
        "enum": [
          "display-lg",
          "display-md",
          "display-sm",
          "lg",
          "md",
          "sm"
        ]
      },
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "values": {
            "display-lg": "Display Lg",
            "display-md": "Display Md",
            "display-sm": "Display Sm",
            "lg": "Lg",
            "md": "Md",
            "sm": "Sm"
          }
        },
        "code": {
          "prop": "variant"
        }
      }
    },
    {
      "name": "weight",
      "type": {
        "enum": [
          "regular",
          "bold"
        ]
      },
      "default": "regular",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Weight",
          "values": {
            "regular": "Regular",
            "bold": "Bold"
          }
        },
        "code": {
          "prop": "isBold"
        }
      }
    },
    {
      "name": "children",
      "type": "text",
      "default": "Heading",
      "description": "Promoted from the computed floor: the root renders its children as direct text (captured mount proof).",
      "bindings": {
        "figma": {
          "kind": "TEXT",
          "property": "Content"
        },
        "code": {
          "prop": "children"
        }
      }
    }
  ],
  "states": [],
  "anatomy": {
    "root": {
      "declared": {
        "display": "block",
        "box-sizing": "border-box",
        "font-family": "\"IBM Plex Sans\", sans-serif"
      },
      "content": {
        "prop": "children"
      },
      "tokens": {
        "font-size": "{imported.heading.root.font-size.unset}",
        "line-height": "{imported.heading.root.line-height.unset}",
        "min-height": "{imported.heading.root.min-height}",
        "min-width": "{imported.heading.root.min-width}",
        "width": "{imported.heading.root.width}"
      },
      "tokensByProp": [
        {
          "prop": "variant",
          "map": {
            "display-lg": {
              "font-size": "{imported.heading.root.font-size.display-lg}",
              "line-height": "{imported.heading.root.line-height.display-lg}"
            },
            "display-md": {
              "font-size": "{imported.heading.root.font-size.display-md}",
              "line-height": "{imported.heading.root.line-height.display-md}"
            },
            "display-sm": {
              "font-size": "{imported.heading.root.font-size.display-sm}",
              "line-height": "{imported.heading.root.line-height.display-sm}"
            },
            "lg": {
              "font-size": "{imported.heading.root.font-size.lg}",
              "line-height": "{imported.heading.root.line-height.lg}"
            },
            "md": {
              "font-size": "{imported.heading.root.font-size.md}",
              "line-height": "{imported.heading.root.line-height.md}"
            },
            "sm": {
              "font-size": "{imported.heading.root.font-size.sm}",
              "line-height": "{imported.heading.root.line-height.sm}"
            }
          }
        },
        {
          "prop": "weight",
          "map": {
            "bold": {
              "font-weight": "{imported.heading.root.font-weight.bold}"
            },
            "regular": {
              "font-weight": "{imported.heading.root.font-weight.regular}"
            }
          }
        }
      ]
    }
  },
  "bindings": {
    "figma": {
      "anchors": {
        "fileKey": null,
        "componentSetKey": null
      }
    },
    "code": {
      "anchors": {
        "importPath": "altitude-web-components",
        "export": "al-heading"
      }
    }
  }
}
